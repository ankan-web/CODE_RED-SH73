rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {

// This function checks if the user has an 'admin' custom claim.
function isAdmin() {
  return request.auth.token.admin == true;
}

// --- DEFAULT RULE: Allow authenticated users to read most data ---
// This is the key rule that will fix your forum loading issue.
// It allows any logged-in user to view posts, comments, resources, etc.
match /{document=**} {
  allow read: if request.auth != null;
}

// --- SPECIFIC RULES FOR WRITING/DELETING DATA ---

// USERS: Users can create their own document and can only modify their own.
match /users/{userId} {
  allow read, write: if request.auth.uid == userId || isAdmin();
}

// POSTS: Logged-in users can create posts. Only the author or an admin can edit/delete.
match /posts/{postId} {
  allow create: if request.auth != null;
  allow update, delete: if resource.data.authorId == request.auth.uid || isAdmin();

  // VOTES: A user can only manage their own vote document.
  match /votes/{userId} {
    allow read, create, delete: if request.auth.uid == userId;
  }
}

// COMMENTS: Logged-in users can create comments. Only the author or an admin can edit/delete.
match /comments/{commentId} {
    allow create: if request.auth != null;
    allow update, delete: if resource.data.authorId == request.auth.uid || isAdmin();
}

// BOOKINGS: Users can create their own bookings and can only manage their own. Admins have full access.
match /bookings/{bookingId} {
    allow create: if request.auth.uid == request.resource.data.userId;
    allow read, update: if resource.data.userId == request.auth.uid || isAdmin();
    allow delete: if isAdmin();
}

// RESOURCES: Only admins can create, update, or delete resources.
match /resources/{resourceId} {
    allow write: if isAdmin();
}

}
}